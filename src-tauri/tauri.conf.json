{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STS2 Character Creator",
  "version": "0.1.0",
  "identifier": "com.sts2charactercreator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STS2 Character Creator",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/runtime/THIRD_PARTY_NOTICES.txt"],
    "icon": ["icons/icon.ico"]
  }
}
