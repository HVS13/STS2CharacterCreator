{
  "name": "sts2-character-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "test": "vitest run",
    "character:schema": "vite-node scripts/generate-schema.ts",
    "character:validate": "vite-node --script scripts/character-cli.ts validate",
    "character:pack": "vite-node --script scripts/character-cli.ts pack",
    "character:verify": "vite-node --script scripts/character-cli.ts verify",
    "character:build": "vite-node --script scripts/character-cli.ts build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
